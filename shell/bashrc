# Shared interactive shell defaults. Machine-specific settings stay in ~/.bashrc.
case $- in
  *i*) ;;
  *) return ;;
esac

export EDITOR=nvim
export VISUAL=nvim
export PATH="$HOME/.local/bin:$PATH"

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init bash)"
fi

alias ll='ls -alF'
alias gs='git status --short --branch'
